RewriteEngine On
RewriteBase /Dropshipping/

# ── HTTPS Enforcement (skip for localhost / 127.0.0.1 in dev) ─────────
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|::1) [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ── Deny access to sensitive files ───────────────────────────────
RewriteRule ^\.env - [F,L]
RewriteRule ^\.env\..* - [F,L]
RewriteRule ^application/ - [F,L]
RewriteRule ^system/ - [F,L]
RewriteRule ^composer\.(json|lock) - [F,L]
RewriteRule ^migrations/ - [F,L]

# ── Deny dev-tools directory (ngrok, cloudflared, bat scripts) ───
RewriteRule ^dev-tools/ - [F,L]
RewriteRule ^_archive/ - [F,L]
RewriteRule ^db\.php - [F,L]

# Route REST API V1 endpoints
RewriteRule ^api/v1/(.*)$ api/v1/index.php [QSA,L]
RewriteRule ^api/v1$ api/v1/index.php [QSA,L]

# ── Asset routing fallbacks ─────────────────────────────────────────
RewriteRule ^css/(.*)$ assets/css/$1 [L]
RewriteRule ^js/(.*)$ assets/js/$1 [L]
RewriteRule ^img/(.*)$ assets/img/$1 [L]

# Remove index.php from URL
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php/$1 [L]

# Security headers
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-XSS-Protection "1; mode=block"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

# Turn off PHP error display via Apache (production safety net)
php_flag display_errors Off
php_flag log_errors On

# Cache static assets
<FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|ico|woff|woff2|ttf|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

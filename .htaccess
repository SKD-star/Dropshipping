RewriteEngine On
RewriteBase /Dropshipping/

# ── Deny access to sensitive files ───────────────────────────────
RewriteRule ^\.env - [F,L]
RewriteRule ^\.env\..* - [F,L]
RewriteRule ^application/ - [F,L]
RewriteRule ^system/ - [F,L]
RewriteRule ^composer\.(json|lock) - [F,L]
RewriteRule ^migrations/ - [F,L]

# ── Deny dev-tools directory (ngrok, cloudflared, bat scripts) ───
RewriteRule ^dev-tools/ - [F,L]
RewriteRule ^_archive/ - [F,L]
RewriteRule ^db\.php - [F,L]

# Route REST API V1 endpoints
RewriteRule ^api/v1/(.*)$ api/v1/index.php [QSA,L]
RewriteRule ^api/v1$ api/v1/index.php [QSA,L]

# ── Asset routing fallbacks ─────────────────────────────────────────
RewriteRule ^css/(.*)$ assets/css/$1 [L]
RewriteRule ^js/(.*)$ assets/js/$1 [L]
RewriteRule ^img/(.*)$ assets/img/$1 [L]

# Remove index.php from URL
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php/$1 [L]

# Security headers
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-XSS-Protection "1; mode=block"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

# Cache static assets
<FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|ico|woff|woff2|ttf|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

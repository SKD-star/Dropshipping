# NovaDrop Commerce OS — Environment Configuration
# Copy this to .env and fill in your values.

# ─── Application ────────────────────────────────────────────
APP_NAME="NovaDrop"
APP_URL=http://localhost/Dropshipping
APP_ENV=development
APP_KEY=CHANGE_THIS_TO_A_RANDOM_32_CHAR_STRING_NOW
STORE_ID=1
STORE_CURRENCY=INR
STORE_CURRENCY_SYMBOL=₹

# ─── Database ────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=novadrop
DB_USER=root
DB_PASS=

# ─── Session & Security ──────────────────────────────────────
SESSION_COOKIE_NAME=novadrop_session
CSRF_TOKEN_NAME=csrf_novadrop

# ─── Email / SMTP ─────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_ADDRESS=noreply@novadrop.in
MAIL_FROM_NAME=NovaDrop

# ─── Payments ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=your_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

STRIPE_PUBLIC_KEY=pk_test_XXXXXXXXXX
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXX

# ─── Dropshipping Suppliers (CJ Dropshipping) ─────────────────
CJ_API_KEY=your_cj_api_key_here
CJ_API_SECRET=your_cj_api_secret_here

# ─── Shipping & Logistics ─────────────────────────────────────
SHIPROCKET_EMAIL=your@email.com
SHIPROCKET_PASSWORD=your_password
SHIPROCKET_CHANNEL_ID=

DELHIVERY_API_KEY=
DELHIVERY_CLIENT_ID=
BLUEDART_CUSTOMER_CODE=
BLUEDART_API_KEY=

# ─── AI Engine ────────────────────────────────────────────────
GEMINI_API_KEY=REPLACE_ME
GEMINI_MODEL=gemini-1.5-flash

# ─── Search (Meilisearch) ─────────────────────────────────────
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# ─── WhatsApp Business & Cloud API ───────────────────────────
WHATSAPP_CLOUD_API_TOKEN=your_meta_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_from_meta_portal
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_account_id_from_meta
WHATSAPP_WEBHOOK_VERIFY_TOKEN=novadrop_secure_webhook_verify_token_123

WATI_API_KEY=
WATI_ENDPOINT_URL=https://live-server-XXXXX.wati.io
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886
